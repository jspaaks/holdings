{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
        "holdings": {
            "minItems": 0,
            "items": {
                "additionalProperties": false,
                "properties": {
                    "ticker": {
                        "pattern": "[A-Z0-9\\.]{1,10}",
                        "type": "string"
                    },
                    "transactions": {
                        "items": {
                            "additionalProperties": false,
                            "properties": {
                                "price": {
                                    "minimum": 0,
                                    "type": "number"
                                },
                                "shares": {
                                    "minimum": 0,
                                    "multipleOf": 0.00001,
                                    "type": "number"
                                },
                                "timestamp": {
                                    "format": "date-time",
                                    "type": "string"
                                },
                                "type": {
                                    "enum": [
                                        "buy",
                                        "sell"
                                    ],
                                    "type": "string"
                                }
                            },
                            "required": [
                                "price",
                                "timestamp",
                                "type"
                            ],
                            "type": "object"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "ticker",
                    "transactions"
                ],
                "type": "object"
            },
            "type": "array",
            "uniqueItems": true
        }
    },
    "required": [
        "holdings"
    ],
    "type": "object"
}